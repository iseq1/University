APP_NAME=Gamer-Passport
APP_VERSION=0.1.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Local development: SQLite
DATABASE_URL=sqlite+aiosqlite:///./gamer_passport.db

# PostgreSQL in docker-compose:
# DATABASE_URL=postgresql+asyncpg://gamer_passport:gamer_passport@localhost:5432/gamer_passport

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
HF_MODEL=google/flan-t5-small

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=gamer_passport

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
